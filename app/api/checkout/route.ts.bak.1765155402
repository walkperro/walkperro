import { randomUUID } from "crypto";
import Stripe from "stripe";

const stripe = new Stripe(process.env.STRIPE_SECRET_KEY!, {
  apiVersion: "2024-06-20",
});

export async function POST(req: Request) {
  try {
    if (!process.env.STRIPE_SECRET_KEY) {
      console.error("STRIPE_SECRET_KEY missing");
      return Response.json({ error: "stripe_not_configured" }, { status: 500 });
    }

    const origin =
      req.headers.get("origin") ??
      (process.env.VERCEL_URL ? `https://${process.env.VERCEL_URL}` : "http://localhost:3000");

    const body = await req.json();
    const priceIds: string[] = Array.isArray(body?.priceIds) ? body.priceIds : [];
    const successPath: string = typeof body?.successPath === "string" ? body.successPath : "/thanks";

    if (priceIds.length === 0) {
      return Response.json({ error: "no_prices" }, { status: 400 });
    }

    const session = await stripe.checkout.sessions.create({
      mode: "payment",
      line_items: priceIds.map((id) => ({ price: id, quantity: 1 })),
      success_url: `${origin}${successPath}?session_id={CHECKOUT_SESSION_ID}`,
      cancel_url: `${origin}`,
      billing_address_collection: "auto",
      allow_promotion_codes: true,
      automatic_tax: { enabled: false },
      // If you want to collect email on Stripe page:
      // customer_creation: "if_required",
    });

    return Response.json({ url: session.url });
  } catch (err: any) {
    console.error("Stripe checkout error:", err?.message || err);
    return Response.json({ error: "checkout_failed" }, { status: 500 });
  }
}
