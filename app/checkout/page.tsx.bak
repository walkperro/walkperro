import { Suspense } from "react";
import ClientCheckout from "./ClientCheckout";

export const dynamic = "force-dynamic";
export const revalidate = 0;

function CheckoutInner() {
  return (
    <div className="mx-auto w-full max-w-3xl px-4 py-12">
      <h1 className="text-2xl font-semibold tracking-tight text-slate-900 mb-4">
        Checkout
      </h1>
      <div id="checkout" className="w-full min-h-[520px] rounded-2xl border border-slate-200 bg-white shadow-sm" />
      <p className="mt-4 text-xs uppercase tracking-wider text-slate-500">
      </p>
    </div>
  );
}

export default function Page() {
