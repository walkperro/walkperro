export default function Stars({ value }: { value: number }) {
  return (
    <div className="leading-none">
      <span style={{ color: "#E5E4E2" }}>
        {"★★★★★".slice(0, value)}
      </span>
      <span style={{ color: "rgba(229,228,226,0.3)" }}>
        {"★★★★★".slice(value)}
      </span>
    </div>
  );
}
