"use client";

import { useState } from "react";

type Props = {
  slug: string;
  title: string;
  price: number;
  payhipCode?: string;
  className?: string;
  children?: React.ReactNode;
};

const PRICE_BY_SLUG: Record<string, string> = {
  "10-quick-codes": "price_1SbjuCCCBLLo4EMcvRTE72Ar",
  "wealth-hacks": "price_1Sbm8tCCBLLo4EMcp76vrtrw",
  "money-moves": "price_1SbmBeCCBLLo4EMc9ueTdbkv",
  "chatgpt-cash-hacks": "price_1SbmDoCCBLLo4EMccp2qIyDo",
  "all-in-one": "price_1SbmGUCCBLLo4EMcI3h2ZHKl",
};

export default function CheckoutButton({ slug, className = "", children }: Props) {
  const [loading, setLoading] = useState(false);

  function go() {
    const priceId = PRICE_BY_SLUG[slug];
    if (!priceId) {
      alert("Missing Stripe price for this product.");
      return;
    }
    setLoading(true);
    window.location.href = `/checkout?price=${priceId}`;
  }

  return (
    <button
      onClick={go}
      disabled={loading}
      className={className || "rounded-full bg-slate-900 text-white px-4 py-2.5 text-sm font-semibold tracking-[0.10em] shadow-md active:scale-95"}
    >
      {loading ? "Processing..." : (children ?? "Buy Now")}
    </button>
  );
}
